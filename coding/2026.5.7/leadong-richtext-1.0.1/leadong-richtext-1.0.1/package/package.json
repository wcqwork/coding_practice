{
  "name": "leadong-richtext",
  "version": "1.0.1",
  "description": "Leadong 富文本编辑器 - 基于 Vue 3 + Tiptap 的所见即所得编辑器，支持 Vue 组件引入 / iframe / script 挂载",
  "author": "Leadong",
  "license": "MIT",
  "type": "module",
  "main": "./lib/leadong-richtext.js",
  "module": "./lib/leadong-richtext.js",
  "exports": {
    ".": "./lib/leadong-richtext.js",
    "./style.css": "./lib/style.css"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "cross-env BUILD_TARGET=lib vite build",
    "build:all": "vite build && cross-env BUILD_TARGET=lib vite build",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "test:e2e": "playwright test tests/e2e/converted-cases",
    "test:e2e:ui": "playwright test tests/e2e/converted-cases --ui",
    "test:e2e:headed": "playwright test tests/e2e/converted-cases --headed",
    "test:e2e:debug": "playwright test tests/e2e/converted-cases --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.398.0",
    "@aws-sdk/xhr-http-handler": "^3.398.0",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@element-plus/icons-vue": "^2.3.1",
    "@playwright/mcp": "^0.0.52",
    "@tiptap/extension-color": "^2.6.6",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-subscript": "^2.6.6",
    "@tiptap/extension-superscript": "^2.6.6",
    "@tiptap/extension-text-align": "^2.6.6",
    "@tiptap/extension-text-style": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@tiptap/suggestion": "^2.6.6",
    "@tiptap/vue-3": "^2.6.6",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ali-oss": "^6.21.0",
    "axios": "^1.6.7",
    "element-plus": "^2.5.3",
    "element-tiptap-vue3-fixed": "^1.1.6",
    "html-validate": "^10.9.0",
    "js-base64": "^3.7.7",
    "js-beautify": "^1.15.4",
    "pinia": "^3.0.3",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.17",
    "vue-codemirror": "^6.1.1",
    "vue-color-kit": "^1.0.6",
    "vue-cookies": "^1.8.6",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "pinia": "^2.0.0 || ^3.0.0",
    "vue-i18n": "^9.0.0",
    "element-plus": "^2.4.0",
    "@tiptap/vue-3": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^10.1.0",
    "sass-embedded": "^1.93.2",
    "terser": "^5.43.1",
    "vite": "^5.0.0",
    "vite-plugin-vue-devtools": "^7.0.0"
  }
}
